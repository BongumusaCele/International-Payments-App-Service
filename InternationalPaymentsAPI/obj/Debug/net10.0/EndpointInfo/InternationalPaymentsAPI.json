  "components": {
    "schemas": {
      "CreateBeneficiaryDto": {
        "required": [
          "customer_Id",
          "currency_Id",
          "beneficiary_Name",
          "bank_Name",
          "account_Number"
        ],
        "type": "object",
        "properties": {
          "customer_Id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "currency_Id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "beneficiary_Name": {
            "type": "string"
          },
          "bank_Name": {
            "type": "string"
          },
          "account_Number": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "country": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "CreateCurrencyDto": {
        "required": [
          "currency_Name",
          "currency_Code",
          "exchange_Rate"
        ],
        "type": "object",
        "properties": {
          "currency_Name": {
            "type": "string"
          },
          "currency_Code": {
            "type": "string"
          },
          "exchange_Rate": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "CreatePaymentDto": {
        "required": [
          "customer_Id",
          "beneficiary_Id",
          "amount",
          "swift_Code"
        ],
        "type": "object",
        "properties": {
          "customer_Id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "beneficiary_Id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "amount": {
            "minimum": 1,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "payment_Reference": {
            "type": [
              "null",
              "string"
            ]
          },
          "payment_Provider": {
            "type": "string"
          },
          "swift_Code": {
            "type": "string"
          },
          "payment_Reason": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "LoginDto": {
        "required": [
          "username",
          "account_Number",
          "password"
        ],
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "account_Number": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "RegisterDto": {
        "required": [
          "first_Name",
          "last_Name",
          "account_Number",
          "currency_Id",
          "username",
          "password",
          "confirm_Password"
        ],
        "type": "object",
        "properties": {
          "first_Name": {
            "type": "string"
          },
          "last_Name": {
            "type": "string"
          },
          "id_Number": {
            "type": "string"
          },
          "email_Address": {
            "type": [
              "null",
              "string"
            ]
          },
          "account_Number": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "currency_Id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "confirm_Password": {
            "type": "string"
          }
        }
      },
      "UpdateBeneficiaryDto": {
        "required": [
          "currency_Id",
          "beneficiary_Name",
          "bank_Name",
          "account_Number"
        ],
        "type": "object",
        "properties": {
          "currency_Id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "beneficiary_Name": {
            "type": "string"
          },
          "bank_Name": {
            "type": "string"
          },
          "account_Number": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "country": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Auth"
    },
    {
      "name": "Beneficiary"
    },
    {
